# Firebase Storage & Project Config
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_PROJECT_ID=your-project-id

# Google Drive Integration Config
# Target Google Drive Folder ID (e.g. celeste-flickr folder)
GDRIVE_FOLDER_ID=1Vxx4Qc8VQMyEg6x4d5CdqL4u0DHP9KA0

# Google Cloud Service Account Authentication
# Option A: Path to service account JSON key file (relative or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Option B (Alternative): Inline service account JSON string
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
